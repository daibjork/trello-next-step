{
  "manifest_version": 3,
  "name": "Trello Next Step",
  "description": "View and check off Trello checklist items directly from the board",
  "version": "1.2.4",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "192": "icons/icon192.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "192": "icons/icon192.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://trello.com/*"],
      "js": ["src/content/index.ts"],
      "css": ["src/content/styles.css"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "*://trello.com/*"
  ],
  "permissions": [
    "storage"
  ]
}
